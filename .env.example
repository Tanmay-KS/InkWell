# InkWell — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the contract.
# Never commit a real key.
#
#   cp .env.example .env
#
# NOTE: inside the OpenShell sandbox you should NOT have a real key in the
# environment at all. The OpenShell provider injects an opaque placeholder for
# NEBIUS_API_KEY and the sandbox proxy substitutes the real value only for
# api.tokenfactory.nebius.com:443. See sandbox/providers/nebius-token-factory.yaml.

# ---------------------------------------------------------------------------
# Nebius Token Factory  (Person A — infra)
# ---------------------------------------------------------------------------
# Inference for the agent loop, OCR for ingestion, and the redaction tier.
# Get a key at https://tokenfactory.nebius.com/ -> project -> API keys.
NEBIUS_API_KEY=

# Base URL. Hermes's built-in `nebius-token-factory` provider already defaults
# to https://api.tokenfactory.nebius.com/v1 and also honours NEBIUS_BASE_URL.
#
# LEAVE THIS UNSET IN THE SANDBOX. Setting it to anything other than the
# Token Factory host is the cleanest possible proof that routing is enforced
# by the runtime and not by our configuration discipline: Hermes will aim at
# the wrong host and OpenShell will refuse the request with
# `credential_endpoint_mismatch`.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model IDs. These MUST be pinned from the live catalog, never hand-typed.
#
#   make pin-models
#
# Two of the model IDs quoted in planning do not exist on Token Factory at
# all (nvidia/NVIDIA-Nemotron-3-Nano-Omni and Qwen/Qwen2.5-VL-72B-Instruct),
# and the casing is inconsistent across Nebius's own docs. The catalog is the
# only authority. As of 2026-10-22 it served 28 models, of which eight
# accept image input:
#
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B   $0.06/$0.24   text only
#   nvidia/Nemotron-3_5-Lightning           $0.06/$0.24   text only
#   nvidia/nemotron-3-super-120b-a12b       $0.30/$0.90   text only
#   nvidia/Nemotron-3.5-Super-VL            $0.30/$0.90   vision  <- Super tier and OCR
#   nvidia/Nemotron-3-Ultra-550b-a55b       $1.00/$3.00   text only
#   openbmb/MiniCPM-V-4_5                   $0.66/$1.11   vision  <- comparator
#   zai-org/GLM-5.3-Flash                   $0.15/$0.50   vision  <- comparator
#   deepseek-ai/DeepSeek-V4.1-Flash         $0.30/$1.20   vision  <- comparator
#   Qwen/Qwen3.8-27B                        $0.45/$3.00   vision  <- comparator
#   moonshotai/Kimi-K3                      $3.00/$15.00  vision  <- too expensive
#
# (prices are per million tokens, input/output)
#
# The Super tier is Super-VL: it is the main reasoning model *and* the
# document reader, it is the model the decision record
# (docs/ocr-decision.md) names, and the one the Phase 2 privacy
# architecture was validated against. A second benchmark run preferred
# MiniCPM-V-4_5 on accuracy and cost; that comparison is open as F-032.
#
# `make pin-models` writes these values into both this file and `.env`,
# from the live catalog, so the two cannot drift.
INKWELL_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
INKWELL_MODEL_SUPER=nvidia/Nemotron-3.5-Super-VL
INKWELL_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
INKWELL_MODEL_OCR=nvidia/Nemotron-3.5-Super-VL
INKWELL_MODEL_REDACT=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# ---------------------------------------------------------------------------
# Tavily  (Person A — search, routed through the privacy router)
# ---------------------------------------------------------------------------
# Keyless access exists but is rate-limited. Get a key at
# https://app.tavily.com/home.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Messaging  (Person B — interface, Phase 4)
# ---------------------------------------------------------------------------
# Telegram: the token runs the interactive bot over long polling; the chat
# ID is the destination for proactive deadline notices. Both can come from
# the bot's own getUpdates call — send it a message, then read the chat id
# from the update.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack: one-way deadline notices through an incoming webhook. There is no
# interactive Slack bot.
SLACK_WEBHOOK_URL=
INKWELL_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Resend  (inbound mail + delivery tracking)
# ---------------------------------------------------------------------------
# Inbound needs a full-access key: Resend's received-email API is unavailable
# to a send-only key, so the body cannot be fetched back. A send-only key
# makes the webhook store metadata and stop at state "pending".
RESEND_API_KEY=
# Svix signing secret for /api/resend/webhook (`whsec_...`). Created with
#   python -m agent.mail webhook-create --endpoint https://.../api/resend/webhook
# Keep it out of git, like every other secret.
RESEND_WEBHOOK_SECRET=

# Attachments read per received email. 0 disables attachment handling; each
# file is capped at 15 MiB and only public https download URLs are accepted.
# INKWELL_MAIL_MAX_ATTACHMENTS=3

# The public Vercel demo returns 404 for /api/mail and 503 for the webhook
# unless this is truthy, because its database is throwaway and may be
# recycled at any time. Leave it unset on the demo; see docs/resend.md.
# INKWELL_MAIL_PUBLIC=0

# ---------------------------------------------------------------------------
# OpenShell  (Person A — sandbox runtime)
# ---------------------------------------------------------------------------
# Point every sandbox at the same policy. Individual `openshell sandbox create`
# calls can override with --policy.
# OPENSHELL_SANDBOX_POLICY=/path/to/InkWell/sandbox/policy.yaml

# The gateway ships anonymous operational telemetry. It never collects prompts,
# file paths, credentials, or model names, but you can opt out.
# OPENSHELL_TELEMETRY_ENABLED=false

# ---------------------------------------------------------------------------
# Local demo  (Phase 4 / upgrade)
# ---------------------------------------------------------------------------
# Per-client sliding window for POST endpoints. Defaults: 30 requests per
# 60 seconds. The server is loopback-only; this is a runaway-page guard,
# not an internet-facing control.
# INKWELL_RATE_LIMIT=30
# INKWELL_RATE_WINDOW=60

# Route the web upload Drafter through Nemotron Super instead of the
# deterministic template. Off by default so the demo makes no model call.
# The deterministic Auditor still reviews the result.
# INKWELL_USE_MODEL_DRAFTER=0
