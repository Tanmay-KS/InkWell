# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node (interface/web tooling, if any) ---------------------------------
node_modules/

# --- Generated corpora and artifacts --------------------------------------
# Synthetic documents are regenerated by `make synth`; they are reproducible
# from eval/gen_synthetic_docs.py and a fixed seed, so they do not belong in
# git. The README in that directory is tracked.
eval/synthetic_docs/*.txt
eval/synthetic_docs/*.json
eval/synthetic_docs/*.jsonl
eval/synthetic_docs/*.png

# Phase 3/4 artifacts
# The Phase 0 results are small and are the evidence behind the model
# decision and the privacy architecture, so they are kept. The Phase 2/3
# results are large, regenerable, and produced late.
eval/results/*
!eval/results/ocr_bench.json
!eval/results/redacted_extract.json
!eval/results/redaction_audit.json
# The memory-with-updates score is the third claim; the artifact is the
# full per-scenario record, including the update-blind baseline.
!eval/results/memory_eval.json
# The leak test is the headline number and it is 4 KB. It is the evidence
# for the video's central claim, so it is kept like the Phase 0 results.
!eval/results/leak_test.json
# The Phase 3 cost/latency table is the third number in the video, and it
# is small. It carries the catalog it was measured against, which is what
# makes the rates auditable later.
!eval/results/cost_latency.json
video/recordings/
*.mp4

# --- OpenShell / local gateway state ---------------------------------------
# The gateway keeps TLS material and its database outside the repo, but keep
# local overrides out of git regardless.
sandbox/local/
*.local.toml
openshell.db
tls/

# The host bootstrap copies the gateway's mTLS client bundle here so a CLI
# running elsewhere can authenticate. These are credentials — never commit.
.openshell/

# Superseded by sandbox/setup.sh, which installs OpenShell from the release
# RPMs with a staged copy into /usr and does the same job without binding the
# gateway's control plane to the LAN. Kept on disk for reference; never
# committed.
sandbox/host-bootstrap.sh

# --- Local OCR test fixture ------------------------------------------------
# A hand-generated, image-only PDF used to check the OCR path on this
# machine. It contains fictional data only and is not part of the product.
/ocr-test-notice.pdf

# --- Editors / OS ----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
