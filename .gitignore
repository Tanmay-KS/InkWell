# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node (interface/web tooling, if any) ---------------------------------
node_modules/

# --- Generated corpora and artifacts --------------------------------------
# Synthetic documents are regenerated by `make synth`; they are reproducible
# from eval/gen_synthetic_docs.py and a fixed seed, so they do not belong in
# git. The README in that directory is tracked.
eval/synthetic_docs/*.txt
eval/synthetic_docs/*.json
eval/synthetic_docs/*.jsonl
eval/synthetic_docs/*.png

# Phase 3/4 artifacts
eval/results/
video/recordings/
*.mp4

# --- OpenShell / local gateway state ---------------------------------------
# The gateway keeps TLS material and its database outside the repo, but keep
# local overrides out of git regardless.
sandbox/local/
*.local.toml
openshell.db
tls/

# --- Editors / OS ----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
